generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ProductType {
  SERVICE
  SOFTWARE
  ADDON
  PHYSICAL
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  ONLINE
}

enum PlanState {
  ACTIVE
  PAUSED
  CLOSED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean   @default(true)
  customerId   String?   @unique @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  customer            Customer?             @relation("CustomerPortalUser", fields: [customerId], references: [id])
  passwordResetTokens  PasswordResetToken[]
  createdCustomers    Customer[]            @relation("CustomerCreatedBy")
  createdSubscriptions Subscription[]       @relation("SubscriptionCreatedBy")
  auditLogs           AuditLog[]
  payments            Payment[]

  @@index([role])
  @@index([isActive])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String
  phone           String?
  company         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  taxId           String?
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  createdByUser User?           @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]
  portalUser    User?           @relation("CustomerPortalUser")

  @@index([createdByUserId])
  @@index([email])
  @@index([company])
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  type        ProductType
  salesPrice  Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean     @default(true)
  taxId       String?     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  tax                  Tax?                  @relation(fields: [taxId], references: [id])
  variants             ProductVariant[]
  subscriptionLines    SubscriptionLine[]
  invoiceLines         InvoiceLine[]
  quotationTemplateLines QuotationTemplateLine[]
  discountProducts     DiscountProduct[]

  @@index([type])
  @@index([isActive])
  @@index([taxId])
  @@index([name])
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  attribute  String
  value      String
  extraPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attribute, value])
  @@index([productId])
  @@index([attribute])
  @@index([value])
}

model Plan {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  price            Decimal      @db.Decimal(12, 2)
  billingPeriod    BillingPeriod
  minQuantity      Int          @default(1)
  startDate        DateTime?    @db.Timestamptz(6)
  endDate          DateTime?    @db.Timestamptz(6)
  autoCloseOnEnd   Boolean      @default(false)
  allowEarlyClose  Boolean      @default(false)
  allowPause       Boolean      @default(false)
  allowRenew       Boolean      @default(true)
  state            PlanState    @default(ACTIVE)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  subscriptions         Subscription[]
  quotationTemplates    QuotationTemplate[]

  @@index([billingPeriod])
  @@index([state])
  @@index([name])
}

model Tax {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  ratePercent        Decimal   @db.Decimal(12, 2)
  isActive           Boolean   @default(true)
  appliesToProductType ProductType?
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  products Product[]

  @@index([isActive])
  @@index([appliesToProductType])
  @@index([name])
}

model Discount {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  type            DiscountType
  value           Decimal       @db.Decimal(12, 2)
  scope           DiscountScope
  minPurchaseAmount Decimal?     @db.Decimal(12, 2)
  minQuantity     Int?
  startDate       DateTime      @db.Timestamptz(6)
  endDate         DateTime?     @db.Timestamptz(6)
  usageLimit      Int?
  usageCount      Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  products         DiscountProduct[]
  subscriptions    DiscountSubscription[]
  invoiceDiscounts  InvoiceDiscount[]

  @@index([scope])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model DiscountProduct {
  id         String   @id @default(uuid()) @db.Uuid
  discountId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
  @@index([discountId])
  @@index([productId])
}

model DiscountSubscription {
  id            String   @id @default(uuid()) @db.Uuid
  discountId    String   @db.Uuid
  subscriptionId String  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([discountId, subscriptionId])
  @@index([discountId])
  @@index([subscriptionId])
}

model QuotationTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  validityDays Int
  planId      String   @db.Uuid
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  plan    Plan                 @relation(fields: [planId], references: [id])
  lines   QuotationTemplateLine[]
  subscriptions Subscription[]

  @@index([planId])
  @@index([name])
}

model QuotationTemplateLine {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  productId   String   @db.Uuid
  variantId   String?  @db.Uuid
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id])

  @@index([templateId])
  @@index([productId])
  @@index([variantId])
}

model Subscription {
  id                  String              @id @default(uuid()) @db.Uuid
  number              String              @unique
  customerId          String              @db.Uuid
  planId              String              @db.Uuid
  status              SubscriptionStatus
  startDate           DateTime            @db.Timestamptz(6)
  expiryDate          DateTime?           @db.Timestamptz(6)
  nextBillingDate     DateTime?           @db.Timestamptz(6)
  paymentTerms        Int                 @default(0)
  quotationValidUntil DateTime?            @db.Timestamptz(6)
  templateId          String?             @db.Uuid
  createdById         String?             @db.Uuid
  pausedAt            DateTime?           @db.Timestamptz(6)
  closedAt            DateTime?           @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)

  customer          Customer            @relation(fields: [customerId], references: [id])
  plan              Plan                @relation(fields: [planId], references: [id])
  template          QuotationTemplate?  @relation(fields: [templateId], references: [id])
  createdBy         User?               @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])
  lines             SubscriptionLine[]
  invoices          Invoice[]
  discountSubscriptions DiscountSubscription[]

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@index([planId])
  @@index([createdById])
  @@index([templateId])
  @@index([startDate])
  @@index([expiryDate])
}

model SubscriptionLine {
  id          String   @id @default(uuid()) @db.Uuid
  subscriptionId String @db.Uuid
  productId   String   @db.Uuid
  variantId   String?  @db.Uuid
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxId       String?  @db.Uuid
  taxRate     Decimal? @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([subscriptionId])
  @@index([productId])
  @@index([variantId])
  @@index([amount])
}

model Invoice {
  id           String       @id @default(uuid()) @db.Uuid
  number       String       @unique
  subscriptionId String?     @db.Uuid
  customerId   String       @db.Uuid
  status       InvoiceStatus
  periodStart  DateTime     @db.Timestamptz(6)
  periodEnd    DateTime     @db.Timestamptz(6)
  issueDate    DateTime     @db.Timestamptz(6)
  dueDate      DateTime     @db.Timestamptz(6)
  subtotal     Decimal      @db.Decimal(12, 2)
  discountTotal Decimal     @db.Decimal(12, 2)
  taxTotal     Decimal      @db.Decimal(12, 2)
  total        Decimal      @db.Decimal(12, 2)
  amountPaid   Decimal      @db.Decimal(12, 2) @default(0)
  notes        String?
  sentAt       DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  discounts    InvoiceDiscount[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([status, dueDate])
  @@index([customerId, status])
  @@index([subscriptionId])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @db.Uuid
  productId     String?  @db.Uuid
  description   String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  taxRate       Decimal? @db.Decimal(12, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([amount])
}

model InvoiceDiscount {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @db.Uuid
  discountId String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id])

  @@unique([invoiceId, discountId])
  @@index([invoiceId])
  @@index([discountId])
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime      @db.Timestamptz(6)
  note         String?
  recordedById String?       @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy  User?   @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([recordedById])
  @@index([method])
}

model Counter {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([key])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}
